DATABASE_URL=postgresql://pm:pm_dev@localhost:5432/pm_dev
REDIS_URL=redis://localhost:6379
KEYCLOAK_URL=https://keycloak.company.com
KEYCLOAK_REALM=pm-realm
KEYCLOAK_CLIENT_ID=pm-app
PORT=3000

# 32-byte hex key for AES-256-GCM encryption of tokens/API keys
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Blueprint base URL (used for user avatar URLs, etc.)
BLUEPRINT_URL=https://blueprint.company.com

# Directory for cloned project repositories (absolute or relative to monorepo root)
WORKSPACE_DIR=workspaces

# Directory for generated project wikis (absolute or relative to monorepo root)
WIKI_DIR=wikis

# playwright-mcp server (page inspection during AI script generation)
PLAYWRIGHT_MCP_URL=http://localhost:8931/mcp

# Automation run worker concurrency per lane (per API instance)
AUTOMATION_LIVE_CONCURRENCY=5
AUTOMATION_EXECUTION_CONCURRENCY=40

# SMTP configuration for email notifications
SMTP_HOST=smtp.gmail.com                                                                                              
SMTP_PORT=587                                                                                                         
SMTP_SECURE=false                                                                                                   
SMTP_USER=your-email@gmail.com                                                                                        
SMTP_PASS=your-app-password
SMTP_FROM=PulseTrack <noreply@pulsetrack.cyberlogitec.com.vn> 